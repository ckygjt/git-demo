# 复制为 .env 后填写；.env 已被忽略，切勿提交密钥
# 不配置任何 Key 时自动进入 Mock 模式：视觉/像素结果读取 data/seed/fixtures 回放，流程完整可演示

# ---------- 模型提供方（任选，按 PROVIDER_ORDER 顺序尝试，全部失败降级 Mock） ----------
PROVIDER_ORDER=dashscope,openai,deepseek

# 通义（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen-vl-max-latest
DASHSCOPE_TEXT_MODEL=qwen-plus

# OpenAI 或任意 OpenAI 兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini

# DeepSeek（仅文本）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat

# ---------- 服务 ----------
LLM_TIMEOUT_SECONDS=40
LLM_CACHE=true

# ---------- 仅用于造评测假样本的生图模型（不属于系统运行时依赖） ----------
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.kkrich.ltd/v1
IMAGE_MODEL=gpt-image-2
